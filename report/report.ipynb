    "    # Remove any NaN values
    "    observed = observed[~np.isnan(observed)]
    "    simulated = simulated[~np.isnan(simulated)]
    "    
    "    chi2_stat, p_value, bin_edges = chi_square_test(observed, simulated)
    "    
    "    print(f\"Column {i+1} (X_{i+1}) Chi-Square Analysis:\")
    "    print(f\"Chi-Square Statistic: {chi2_stat:.4f}\")
    "    print(f\"P-value: {p_value:.4f}\")
    "    
    "    if p_value < 0.05:
    "        print(f\"Interpretation: Reject Null Hypothesis - Significant difference between observed and simulated data\")
    "    else:
    "        print(f\"Interpretation: Fail to Reject Null Hypothesis - No significant difference between observed and simulated data\")
    "    print(\"\")
",
    "    
    "    # Plot observed vs expected frequencies
    "    plt.figure(figsize=(8, 5))
    "    
    "    # Calculate bin centers for plotting
    "    bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2
    "    
    "    # Plot observed frequencies
    "    observed_counts, _ = np.histogram(observed, bins=bin_edges)
    "    plt.bar(bin_centers - 0.05, observed_counts, width=0.1, color='blue', alpha=0.7, label='Observed')
    "    
    "    # Plot expected frequencies
    "    expected_counts, _ = np.histogram(simulated, bins=bin_edges)
