    "plt.xlabel('Grabbing Order', fontsize=12)\n",
    "plt.ylabel('Amount (RMB)', fontsize=12)\n",
    "plt.xticks([0, 1, 2], ['1st Grabber', '2nd Grabber', '3rd Grabber'])\n",
