    "# =========================
",
    "# 2) Chi-Square Test
",
    "# =========================
",
    "def chi_square_test(observed, simulated, num_bins=10):
",
    "    \"""
    "    Perform Chi-Square goodness-of-fit test between observed and simulated data
    "    
    "    Parameters:
    "    observed (np.ndarray): Observed data for a single column
    "    simulated (np.ndarray): Simulated data for the same column
    "    num_bins (int): Number of bins to use for the test
    "    
    "    Returns:
    "    tuple: Chi-Square statistic, p-value, bin edges
    "    """
    "    # Combine both datasets to determine common bin edges
    "    combined = np.concatenate([observed, simulated])
    "    bin_edges = np.linspace(np.min(combined), np.max(combined), num_bins + 1)
    "    
    "    # Calculate observed frequencies
    "    observed_counts, _ = np.histogram(observed, bins=bin_edges)
    "    
    "    # Calculate expected frequencies from simulated data
    "    expected_counts, _ = np.histogram(simulated, bins=bin_edges)
    "    
    "    # Normalize expected counts to match the observed sample size
    "    expected_counts = expected_counts * (len(observed) / len(simulated))
    "    
    "    # Ensure expected counts are at least 5 (rule of thumb for Chi-Square test)
    "    valid_bins = expected_counts >= 5
    "    if not np.all(valid_bins):
    "        print(f\"Warning: Some bins have expected counts < 5. Using {np.sum(valid_bins)} out of {num_bins} bins.\")
    "        
    "    observed_counts = observed_counts[valid_bins]
    "    expected_counts = expected_counts[valid_bins]
    "    
    "    # Perform Chi-Square test
    "    chi2_stat, p_value = stats.chisquare(observed_counts, expected_counts)
    "    
    "    return chi2_stat, p_value, bin_edges
",
    "
",
    "print(\"Chi-Square Test Results:\")
",
    "print(\"-\" * 50)
",
    "
",
