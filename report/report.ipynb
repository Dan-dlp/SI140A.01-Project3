    "    plt.bar(bin_centers + 0.05, expected_counts, width=0.1, color='red', alpha=0.7, label='Expected')
    "    
    "    plt.xlabel('Amount')
    "    plt.ylabel('Frequency')
    "    plt.title(f'Chi-Square Test for Column {i+1}')
    "    plt.legend()
    "    plt.grid(True, alpha=0.3)
    "    plt.show()"
   ]
