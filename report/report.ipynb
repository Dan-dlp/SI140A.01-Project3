    "import numpy as np",
    "import pandas as pd",
    "import matplotlib.pyplot as plt",
    "from scipy import stats",
    "",
    "# =========================",
    "# 1) Generate synthetic data using Double Expectation model",
    "# =========================",
    "def generate_red_packets(total_amount, num_people, num_trials):
",
    "    \"""
    "    Generate red packet data using the Double Expectation model
    "    
    "    Parameters:
    "    total_amount (float): Total amount of money in each red packet
    "    num_people (int): Number of people receiving each red packet
    "    num_trials (int): Number of red packets to generate
    "    
    "    Returns:
    "    np.ndarray: Generated data of shape (num_trials, num_people)
    "    """
    "    results = []
    "    
    "    for _ in range(num_trials):
    "        remaining = total_amount
    "        amounts = []
    "        
    "        for i in range(num_people):
    "            if i == num_people - 1:
    "                # Last person gets all remaining money
    "                amount = remaining
    "            else:
    "                # Double expectation constraint: 0 <= amount <= 2 * remaining / (num_people - i)
    "                expectation = remaining / (num_people - i)
    "                amount = np.random.uniform(0, 2 * expectation)
    "            
    "            amounts.append(amount)
    "            remaining -= amount
    "        
    "        results.append(amounts)
    "    
    "    return np.array(results)
",
    "
",
    "# Generate synthetic data (5 RMB for 3 people, 100 trials)
